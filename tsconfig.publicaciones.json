{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "incremental": false },
  "include": [
    "next-env.d.ts",
    "lib/publicaciones/**/*.ts",
    "lib/integrations/facebook/**/*.ts",
    "lib/integrations/youtube/**/*.ts",
    "lib/integrations/tiktok/**/*.ts",
    "app/api/cron/publicaciones-publicar/**/*.ts",
    "app/api/publicaciones/**/*.ts",
    "app/api/oauth/google/**/*.ts",
    "app/api/oauth/tiktok/**/*.ts",
    "app/(dashboard)/publicaciones/**/*.tsx",
    "components/publicaciones/**/*.ts",
    "components/publicaciones/**/*.tsx",
    "lib/nav/sections.ts",
    "lib/social/openai.ts",
    "lib/contenido/route-auth.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
